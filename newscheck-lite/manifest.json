{
  "manifest_version": 3,
  "name": "NewsCheck Lite",
  "version": "1.0.0",
  "description": "Quickly check if a news claim is likely true, false, or unclear via a server API.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "NewsCheck Lite",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}


